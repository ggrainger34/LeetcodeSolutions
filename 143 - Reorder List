# Definition for singly-linked list.
# class ListNode:
#     def __init__(self, val=0, next=None):
#         self.val = val
#         self.next = next
class Solution:
    def reorderList(self, head: ListNode | None) -> None:
        """
        Do not return anything, modify head in-place instead.
        """


        # Do a pass and collect the all values
        values = []

        curr = head

        while curr:
            values.append(curr.val)
            curr = curr.next

        # Get first and second half
        midpoint = (0 + len(values) + 1) // 2
        # print(midpoint)
        first_half = values[0:midpoint]
        second_half = values[midpoint:]
        second_half.reverse()

        # print(first_half, second_half)

        # Do another pass and reinsert into the linked list
        curr = head
        counter = 0

        while curr:
            if counter % 2 == 0:
                curr.val = first_half[counter // 2]
            else:
                curr.val = second_half[counter // 2]
            counter += 1
            curr = curr.next

        return head
